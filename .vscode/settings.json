{
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.ts": "typescript"
  },
  "editor.tabSize": 2,
  "editor.wordWrapColumn": 100,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  // "tailwindCSS.validate": false,
  "tailwindCSS.experimental.classRegex": [],
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "prettier.singleQuote": true,
  "prettier.semi": false,
  "peacock.color": "#6bb52f",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#84cf48",
    "activityBar.activeBorder": "#15202b",
    "activityBar.background": "#84cf48",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#3577ca",
    "activityBarBadge.foreground": "#e7e7e7",
    "activityBarTop.activeBackground": "#84cf48",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#84cf48",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.border": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "sash.hoverBorder": "#84cf48",
    "statusBar.background": "#6bb52f",
    "statusBar.debuggingBackground": "#6bb52f",
    "statusBar.debuggingForeground": "#15202b",
    "statusBar.foreground": "#15202b",
    "statusBar.inactiveBackground": "#6bb52f",
    "statusBarItem.hoverBackground": "#538c24",
    "statusBarItem.remoteBackground": "#e6eef8",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#6bb52f",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#6bb52f99",
    "titleBar.inactiveForeground": "#15202b99"
  }
}
